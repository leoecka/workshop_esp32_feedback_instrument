	(text "Mikrofon direkt aufstecken oder über Dupont-Kabel.\nL/R auf GND = linker Kanal."
		(exclude_from_sim no)
		(at 58.42 96.52 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "0cea09bd-dc05-46b5-9154-5f82bd6bde20")
	)
	(text "Poti an GPIO 34 (ADC1). Footprint passt für Alps RK09K,\nBourns PTV09 und Alpha 9 mm."
		(exclude_from_sim no)
		(at 58.42 132.08 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "26347f26-1b63-4a85-b48c-3e7bfd1ca491")
	)
	(text "JP1 gesteckt: Verstärker spielt nur den linken Kanal.\nOffen: Mischung aus links und rechts."
		(exclude_from_sim no)
		(at 233.68 45.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4b908003-e41a-4372-a334-f3bb742f0eeb")
	)
	(text "JOKER: z. B. Piezo-Vorverstärker an 3V3, Ausgang an A1/A2.\nA1 = GPIO 36, A2 = GPIO 39 (ADC1, geht auch mit ESP-NOW).\n1k schützt vor negativen Spannungen."
		(exclude_from_sim no)
		(at 58.42 172.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "5375d2f8-b68f-4fd1-85b3-8bb866192e2b")
	)
	(text "Alle Bauteile auf der Oberseite. Antennenende des ESP über der Sperrfläche."
		(exclude_from_sim no)
		(at 116.84 149.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "5b0dab59-8cf9-413c-8102-2b097fd9df8b")
	)
	(text "JP2 Verstärkung: Brücke 1-2 = 12 dB, offen = 9 dB, Brücke 2-3 = 6 dB."
		(exclude_from_sim no)
		(at 233.68 91.44 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "97e7c576-2c2d-458e-acbb-f51f5a85941a")
	)
	(text "PCM5102A, Lötbrücken auf der Rückseite:\nFLT L, DEMP L, XSMT H, FMT L. Sonst bleibt er stumm.\nSCK liegt hier auf GND."
		(exclude_from_sim no)
		(at 233.68 111.76 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9fb104ef-77a1-4d1f-8eca-bafed2ea158d")
	)
	(text "J1 AMP und J3 LINE OUT hängen an denselben I2S-Leitungen.\nEines oder beide stecken."
		(exclude_from_sim no)
		(at 208.28 121.92 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
